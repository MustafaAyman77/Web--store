# ==========================================================================
# أسواق البسيط — Backend Environment (example)
# انسخ هذا الملف إلى ".env" وعدّل القيم. ملف .env الحقيقي لا يدخل Git أبدًا.
# ==========================================================================

PORT=3000
NODE_ENV=development

# مسار قاعدة البيانات (نسبي لمجلد backend أو مسار مطلق)
DATABASE_PATH=./data/basit-market.db

# السماح بالطلبات من origins إضافية (اختياري، مفصولة بفاصلة) — مثال:
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_ORIGINS=

# --- Admin (يُستخدم عند التزويد بالبيانات seed) ---
ADMIN_USERNAME=admin
# ⚠️ غيّرها فورًا بكلمة قوية — تُخزَّن مشفَّرة (hash) وليست كنص صريح
ADMIN_PASSWORD=CHANGE_ME

# --- التوصيل ---
# false = لا يُقبل التوصيل كخدمة مؤكدة (الاستلام من المحل يظل متاحًا)
DELIVERY_ENABLED=true
# رسوم التوصيل تُضبط لاحقًا من صاحب المحل (تُترك 0 في الـDemo)
DELIVERY_FEE=0

# --- Telegram (المرحلة 5 — لا تفعّلها الآن) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
