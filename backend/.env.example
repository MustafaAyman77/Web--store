# ==========================================================================
# أسواق البسيط — Backend Environment (example)
# انسخ هذا الملف إلى ".env" وعدّل القيم. ملف .env الحقيقي لا يدخل Git أبدًا.
# ==========================================================================

PORT=3000
NODE_ENV=development

# مسار قاعدة البيانات (نسبي لمجلد backend أو مسار مطلق)
DATABASE_PATH=./data/basit-market.db

# السماح بالطلبات من origins إضافية (اختياري، مفصولة بفاصلة) — مثال:
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_ORIGINS=

# --- Admin (يُستخدم عند التزويد بالبيانات seed) ---
ADMIN_USERNAME=admin
# ⚠️ غيّرها فورًا بكلمة قوية — تُخزَّن مشفَّرة (hash) وليست كنص صريح
ADMIN_PASSWORD=CHANGE_ME

# --- التوصيل ---
# false = لا يُقبل التوصيل كخدمة مؤكدة (الاستلام من المحل يظل متاحًا)
DELIVERY_ENABLED=true
# رسوم التوصيل تُضبط لاحقًا من صاحب المحل (تُترك 0 في الـDemo)
DELIVERY_FEE=0

# --- Telegram (المرحلة 5 — لا تفعّلها الآن) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=10000

# --- حسابات العملاء + OTP (المرحلة 9) ---
CUSTOMER_AUTH_ENABLED=true
OTP_PROVIDER=demo
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SESSION_TTL_HOURS=720
# ⚠️ سر الجلسات — ولّد قيمة عشوائية طويلة، ولا تدخل Git أبدًا
SESSION_SECRET=

# --- التتبع والإشعارات (المرحلة 10) ---
ORDER_TRACKING_ENABLED=true
NOTIFICATIONS_ENABLED=true
ORDER_STATUS_POLL_INTERVAL_SECONDS=30
